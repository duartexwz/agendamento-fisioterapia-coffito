{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/src/:path*", "destination": "/front/src/:path*" },
    { "source": "/login.html", "destination": "/front/login.html" },
    { "source": "/login", "destination": "/front/login.html" },
    { "source": "/admin.html", "destination": "/front/admin.html" },
    { "source": "/admin", "destination": "/front/admin.html" },
    { "source": "/cadastros.html", "destination": "/front/cadastros.html" },
    { "source": "/cadastros", "destination": "/front/cadastros.html" },
    { "source": "/index.html", "destination": "/front/index.html" },
    { "source": "/", "destination": "/front/index.html" }
  ]
}